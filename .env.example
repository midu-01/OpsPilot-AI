POSTGRES_PASSWORD=opspilot_local

# Select provider: anthropic (default), groq, or fake for an offline demo.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# For deterministic tool demo runs use LLM_PROVIDER=fake and FAKE_MODEL=scenario.
FAKE_MODEL=scripted

# Optional list-price estimates in USD per million tokens, indexed by provider/model.
MODEL_PRICES='{"anthropic/claude-haiku-4-5-20251001":{"input_usd":"0.80","output_usd":"4.00","cached_input_usd":"0.08"},"groq/openai/gpt-oss-20b":{"input_usd":"0.075","output_usd":"0.30","cached_input_usd":"0.037"}}'
BUSINESS_TIMEZONE=UTC
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=40
MODEL_TIMEOUT_SECONDS=60
MAX_ACTIVE_RUN_SECONDS=300

# Policy search embeddings: local (bundled BAAI/bge-small-en-v1.5 model) or hashing (deterministic, for tests).
EMBEDDING_PROVIDER=local
# Turns off ONNX Runtime telemetry when the embedding model runs outside Docker (the image already sets it).
ORT_DISABLE_TELEMETRY=1
