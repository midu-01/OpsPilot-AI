POSTGRES_PASSWORD=opspilot_local

# Select a real provider: groq, openai, or omniroute. Use fake for an offline demo.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=antigravity/gemini-3.8-flash-high
# Docker reaches the host using this name. Native runs use http://localhost:20128/v1.
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1

# Optional list-price estimates in USD per million tokens, indexed by provider/model.
MODEL_PRICES='{"groq/openai/gpt-oss-20b":{"input_usd":"0.075","output_usd":"0.30","cached_input_usd":"0.037"}}'
BUSINESS_TIMEZONE=UTC
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=40
MODEL_TIMEOUT_SECONDS=60
MAX_ACTIVE_RUN_SECONDS=300
