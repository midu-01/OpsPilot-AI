POSTGRES_PASSWORD=opspilot_local

# Select provider: groq (default) or fake for an offline demo. Anthropic support planned.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional list-price estimates in USD per million tokens, indexed by provider/model.
MODEL_PRICES='{"groq/openai/gpt-oss-20b":{"input_usd":"0.075","output_usd":"0.30","cached_input_usd":"0.037"}}'
BUSINESS_TIMEZONE=UTC
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=40
MODEL_TIMEOUT_SECONDS=60
MAX_ACTIVE_RUN_SECONDS=300
